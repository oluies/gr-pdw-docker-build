# syntax=docker/dockerfile:1.7
# Lightweight variant that builds gr-pdw on top of the upstream GNU Radio image.
# Pin to a tag that exists on Docker Hub; override at build time if needed:
#   docker build -f Dockerfile.simple --build-arg GNURADIO_IMAGE=gnuradio/gnuradio:3.10 .
ARG GNURADIO_IMAGE=gnuradio/gnuradio:3.10
FROM ${GNURADIO_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC \
    PYTHONUNBUFFERED=1 \
    GRC_BLOCKS_PATH=/usr/local/share/gnuradio/grc/blocks \
    LD_LIBRARY_PATH=/usr/local/lib:${LD_LIBRARY_PATH}

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3-h5py \
      git \
      cmake \
      ninja-build \
      build-essential \
      ca-certificates \
      vim \
      nano \
      wget \
 && rm -rf /var/lib/apt/lists/*

ARG GR_PDW_REF=master
WORKDIR /tmp
RUN git clone --depth 1 --branch "${GR_PDW_REF}" https://github.com/gtri/gr-pdw.git \
 && cmake -S gr-pdw -B gr-pdw/build -G Ninja -DCMAKE_BUILD_TYPE=Release \
 && cmake --build gr-pdw/build -j"$(nproc)" \
 && cmake --install gr-pdw/build \
 && ldconfig \
 && rm -rf gr-pdw

WORKDIR /workspace

RUN python3 -c "import gnuradio; print('GNU Radio version:', gnuradio.version())" \
 && python3 -c "import h5py; print('h5py installed successfully')" \
 && python3 -c "import pdw; print('gr-pdw installed successfully')"

CMD ["/bin/bash"]
