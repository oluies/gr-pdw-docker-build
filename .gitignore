# Docker
.docker.xauth

# Workspace files — keep scripts + sample images, ignore generated data
workspace/*
!workspace/.gitkeep
!workspace/*.py
!workspace/images/
workspace/images/*.html
!workspace/images/*.png

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# GNU Radio
*.pyc
*.grc~
*.grc.bak

# PDW data files
*.hdf5
*.h5
*.dat

# Logs
*.log
